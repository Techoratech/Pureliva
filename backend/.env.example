NODE_ENV=development
PORT=5000
CLIENT_URLS=http://localhost:5173,https://purelivafoods.com,https://www.purelivafoods.com

# MongoDB Atlas
MONGO_URI=

# Auth
JWT_SECRET=
JWT_EXPIRES_IN=7d
COOKIE_DOMAIN=

# Seed admin (used only by the seed script)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email - Resend (primary)
RESEND_API_KEY=
MAIL_FROM="Pureliva Foods <info@purelivafoods.com>"
ADMIN_NOTIFY_EMAIL=

# Email - SMTP fallback (Hostinger)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Optional: image uploads to Cloudflare R2 (phase 6, optional)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
