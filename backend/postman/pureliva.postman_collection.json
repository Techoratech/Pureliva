              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 109,\n  \"mrp\": 135,\n  \"stock\": 150,\n  \"isActive\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/products/:productId",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "products", ":productId"],
